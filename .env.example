# Bu faylni nusxalab .env deb saqlang va haqiqiy qiymatlarni kiriting.
# .env fayli hech qachon Git'ga qo'shilmasligi kerak (.gitignore ga qarang).

# @BotFather orqali olingan bot tokeni
BOT_TOKEN=123456789:AAExampleTokenHereReplaceMe

# Admin(lar) Telegram ID'si. Bir nechtasi bo'lsa vergul bilan ajrating.
ADMIN_IDS=123456789,987654321

# Ixtiyoriy sozlamalar (agar kerak bo'lmasa qoldirib ketishingiz mumkin)
DB_PATH=database.db
NICKS_PER_PAGE=10
SEARCH_RESULT_LIMIT=20
LOG_LEVEL=INFO
